# ==============================================================================
# LINSI-OS · Fase 8 — soporte de hardware para arrancar en máquinas reales y VMs
# ------------------------------------------------------------------------------
# Fragmento aparte de kernel-hardening.config (que queda sólo para seguridad).
# Agregado 2026-10-27 al preparar la primera imagen booteable: el defconfig +
# hardening de Fase 1 no tenía NVMe, ni framebuffer de arranque, ni consola
# gráfica, ni amdgpu, ni códecs de sonido, ni WiFi Intel, ni overlayfs.
#
# Criterio y por qué (no hay initramfs):
#   - =y lo que hace falta para LLEGAR al disco raíz y ver algo en pantalla:
#     controladores de disco (NVMe, SATA ya estaba, USB/UAS, SD, virtio,
#     Hyper-V), btrfs (ya estaba), framebuffer EFI (simpledrm) + consola.
#   - =m lo que pide FIRMWARE (amdgpu, iwlwifi): compilado adentro, el driver
#     arranca antes de que exista el disco raíz, request_firmware() no
#     encuentra /usr/lib/firmware y el dispositivo queda muerto. Como módulo
#     lo carga udev cuando el raíz ya está montado. Los módulos se firman
#     solos (MODULE_SIG_ALL) y MODULE_SIG_FORCE sigue activo.
# ==============================================================================

# --- Almacenamiento ---
# NVMe: la mayoría de los discos de PCs y notebooks actuales.
CONFIG_BLK_DEV_NVME=y
# USB Attached SCSI: pendrives/discos USB 3 rápidos.
CONFIG_USB_UAS=y
# Lectores de tarjetas SD.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
# Disco virtio-scsi (QEMU/Proxmox).
CONFIG_SCSI_VIRTIO=y

# --- Video ---
# Framebuffer que deja el firmware UEFI (GOP): imagen desde el primer
# segundo en cualquier GPU, y fallback si el driver real falla o no existe.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# Consola de texto sobre DRM. Sin esto la pantalla queda negra hasta que
# arranca la sesión gráfica (no se ven ni los mensajes de arranque).
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# AMD (pide firmware -> módulo).
CONFIG_DRM_AMDGPU=m
# GPUs virtuales: QEMU stdvga, VMware/VirtualBox (VMSVGA), Hyper-V.
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_HYPERV=y

# --- Invitado Hyper-V (el host de desarrollo es Windows) ---
CONFIG_HYPERV=y
CONFIG_HYPERV_UTILS=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y

# --- Sonido ---
# Sin códec el controlador HDA carga pero no suena nada. Los menús prenden
# todas sus variantes por defecto (ALC*, HDMI Intel/AMD/NVIDIA).
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_VIRTIO=y

# --- Red ---
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_MAC80211=y
# WiFi Intel (pide firmware -> módulo). MVM: chips hasta AX2xx; MLD: BE2xx.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m

# --- Entrada ---
# Touchpads y pantallas táctiles HID.
CONFIG_HID_MULTITOUCH=y

# --- Filesystems ---
# overlayfs: Podman/Distrobox y Flatpak (Fase 7).
CONFIG_OVERLAY_FS=y
# FUSE: portal de documentos de xdg-desktop-portal, KIO FUSE, Flatpak.
CONFIG_FUSE_FS=y
# squashfs: imágenes live/instalador de Fase 8.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
# efivarfs adentro: systemd lo monta temprano (bootctl, variables EFI).
CONFIG_EFIVAR_FS=y

# --- VMs ---
CONFIG_HW_RANDOM_VIRTIO=y
